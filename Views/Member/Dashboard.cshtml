@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Member Dashboard";



}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Member Dashboard</h2>

        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>





</div>

<style>
    .kpi-card-clean {
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .kpi-card-clean h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
            color: #1f2d2a;
        }

        .kpi-card-clean p {
            margin: 0;
            color: #6c7a74;
            font-weight: 600;
        }

    .stat-icon-box {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }

    .bg-warning-soft {
        background: #fff7e6;
        color: #b7791f;
    }

    .quick-action-box {
        min-height: 135px;
        border: 1px solid #dbe7df;
        border-radius: 16px;
        background: #ffffff;
        color: #1f2d2a;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: 0.2s ease;
        padding: 18px;
    }

        .quick-action-box i {
            font-size: 2rem;
            color: #2e7d5e;
        }

        .quick-action-box span {
            font-weight: 700;
            text-align: center;
        }

        .quick-action-box:hover {
            border-color: #2e7d5e;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(46, 125, 94, 0.12);
            color: #2e7d5e;
        }
</style>