@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Member Dashboard";

    var totalBorrowed = ViewBag.TotalBorrowed ?? 0;
    var currentlyBorrowed = ViewBag.CurrentlyBorrowed ?? 0;
    var overdue = ViewBag.Overdue ?? 0;
    var pendingReservations = ViewBag.PendingReservations ?? 0;

    var recentBorrowings = ViewBag.RecentBorrowings as List<BorrowTransaction> ?? new List<BorrowTransaction>();
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Member Dashboard</h2>
        <p>Browse books, track borrowing history, renew books, and manage reservations.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-6 col-md-6">
            <div class="lms-card h-100 kpi-card-clean">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <h3>@totalBorrowed</h3>
                    <p>Total Borrowed</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-6">
            <div class="lms-card h-100 kpi-card-clean">
                <div class="stat-icon-box bg-primary-soft">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div>
                    <h3>@currentlyBorrowed</h3>
                    <p>Currently Borrowed</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-6">
            <div class="lms-card h-100 kpi-card-clean">
                <div class="stat-icon-box bg-danger-soft">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h3>@overdue</h3>
                    <p>Overdue Books</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-6">
            <div class="lms-card h-100 kpi-card-clean">
                <div class="stat-icon-box bg-warning-soft">
                    <i class="bi bi-bookmark-check"></i>
                </div>
                <div>
                    <h3>@pendingReservations</h3>
                    <p>Pending Reservations</p>
                </div>
            </div>
        </div>

    </div>

    <div class="lms-card mb-4">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-lightning-charge"></i>
                Quick Actions
            </h3>
        </div>

        <div class="lms-card-body">
            <div class="row g-3">

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Book" asp-action="Index" class="quick-action-box">
                        <i class="bi bi-search"></i>
                        <span>Browse Books</span>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="BorrowTransaction" asp-action="MyBorrowings" class="quick-action-box">
                        <i class="bi bi-clock-history"></i>
                        <span>My Borrowings</span>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Reservation" asp-action="MyReservations" class="quick-action-box">
                        <i class="bi bi-bookmark-check"></i>
                        <span>My Reservations</span>
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Account" asp-action="Profile" class="quick-action-box">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </div>

            </div>
        </div>
    </div>

    <div class="lms-card">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-journal-bookmark"></i>
                Recent Borrow History
            </h3>

            <a asp-controller="BorrowTransaction" asp-action="MyBorrowings" class="btn btn-lms-outline">
                View All
            </a>
        </div>

        <div class="lms-card-body">
            @if (recentBorrowings.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Borrow Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Fine</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }

                            @foreach (var item in recentBorrowings)
                            {
                                var isOverdue = item.Status == "Borrowed" && item.DueDate.Date < DateTime.Now.Date;

                                <tr>
                                    <td>@counter</td>
                                    <td>
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">@(item.Book?.Author ?? "Unknown Author")</div>
                                    </td>
                                    <td>@item.BorrowDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (item.Status == "Returned")
                                        {
                                            <span class="status-badge badge-available">Returned</span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="status-badge badge-unavailable">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">Borrowed</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.FineAmount > 0)
                                        {
                                            <strong class="text-danger">@item.FineAmount.ToString("C")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No fine</span>
                                        }
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Borrowing History</h4>
                    <p class="text-muted">You have not borrowed any book yet.</p>

                    <a asp-controller="Book" asp-action="Index" class="btn btn-lms-primary">
                        <i class="bi bi-search me-1"></i>
                        Browse Books
                    </a>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .kpi-card-clean {
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .kpi-card-clean h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
            color: #1f2d2a;
        }

        .kpi-card-clean p {
            margin: 0;
            color: #6c7a74;
            font-weight: 600;
        }

    .stat-icon-box {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }

    .bg-warning-soft {
        background: #fff7e6;
        color: #b7791f;
    }

    .quick-action-box {
        min-height: 135px;
        border: 1px solid #dbe7df;
        border-radius: 16px;
        background: #ffffff;
        color: #1f2d2a;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: 0.2s ease;
        padding: 18px;
    }

        .quick-action-box i {
            font-size: 2rem;
            color: #2e7d5e;
        }

        .quick-action-box span {
            font-weight: 700;
            text-align: center;
        }

        .quick-action-box:hover {
            border-color: #2e7d5e;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(46, 125, 94, 0.12);
            color: #2e7d5e;
        }
</style>