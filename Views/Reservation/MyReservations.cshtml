@model List<LibraryManagementSystem.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";

    var totalReservations = Model.Count;
    var pendingReservations = Model.Count(x => x.Status == "Pending");
    var approvedReservations = Model.Count(x => x.Status == "Approved");
    var cancelledReservations = Model.Count(x => x.Status == "Cancelled");
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>My Reservations</h2>
        <p>Track reserved books and manage pending reservation requests.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-primary-soft">
                        <i class="bi bi-bookmark"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@totalReservations</h3>
                        <p class="text-muted mb-0">Total Reservations</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-warning-soft">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@pendingReservations</h3>
                        <p class="text-muted mb-0">Pending</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-success-soft">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@approvedReservations</h3>
                        <p class="text-muted mb-0">Approved</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-danger-soft">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@cancelledReservations</h3>
                        <p class="text-muted mb-0">Cancelled</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="lms-card">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-bookmark-check"></i>
                Reservation Records
            </h3>

            <a asp-controller="Book" asp-action="Index" class="btn btn-lms-outline">
                <i class="bi bi-search me-1"></i>
                Browse Books
            </a>
        </div>

        <div class="lms-card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Reservation Date</th>
                                <th>Approved Date</th>
                                <th>Cancelled Date</th>
                                <th>Status</th>
                                <th>Book Availability</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int counter = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="#">@counter</td>

                                    <td data-label="Book">
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">
                                            @(item.Book?.Author ?? "Unknown Author")
                                        </div>
                                    </td>

                                    <td data-label="Reservation Date">
                                        @item.ReservationDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td data-label="Approved Date">
                                        @if (item.ApprovedDate.HasValue)
                                        {
                                            @item.ApprovedDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not approved</span>
                                        }
                                    </td>

                                    <td data-label="Cancelled Date">
                                        @if (item.CancelledDate.HasValue)
                                        {
                                            @item.CancelledDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not cancelled</span>
                                        }
                                    </td>

                                    <td data-label="Status">
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="status-badge badge-available">Approved</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="status-badge badge-unavailable">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">Pending</span>
                                        }
                                    </td>

                                    <td data-label="Book Availability">
                                        @if (item.Book?.IsAvailable == true)
                                        {
                                            <span class="status-badge badge-available">Available</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-unavailable">Unavailable</span>
                                        }
                                    </td>

                                    <td data-label="Action">
                                        @if (item.Status == "Pending")
                                        {
                                            <form asp-controller="Reservation"
                                                  asp-action="CancelReservation"
                                                  method="post"
                                                  onsubmit="return confirm('Cancel this reservation?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Completed
                                            </span>
                                        }
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bookmark-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Reservations Found</h4>
                    <p class="text-muted">
                        You have not reserved any book yet.
                    </p>

                    <a asp-controller="Book" asp-action="Index" class="btn btn-lms-primary">
                        <i class="bi bi-search me-1"></i>
                        Browse Books
                    </a>
                </div>
            }

        </div>
    </div>

</div>

<style>
    .stat-icon-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }

    .bg-warning-soft {
        background: #fff7e6;
        color: #b7791f;
    }
</style>