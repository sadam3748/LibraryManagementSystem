@model List<LibraryManagementSystem.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";

    var totalReservations = Model.Count;
    var pendingReservations = Model.Count(x => x.Status == "Pending");
    var approvedReservations = Model.Count(x => x.Status == "Approved");
    var cancelledReservations = Model.Count(x => x.Status == "Cancelled");
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Book Reservations</h2>
        <p>Manage member reservation requests. When a reserved book becomes available, admin can approve it and issue the book to the member.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 reservation-kpi-card">
                <div class="stat-icon-box bg-primary-soft">
                    <i class="bi bi-bookmark"></i>
                </div>
                <div>
                    <h3>@totalReservations</h3>
                    <p>Total Reservations</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 reservation-kpi-card">
                <div class="stat-icon-box bg-warning-soft">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h3>@pendingReservations</h3>
                    <p>Pending</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 reservation-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <h3>@approvedReservations</h3>
                    <p>Approved / Issued</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 reservation-kpi-card">
                <div class="stat-icon-box bg-danger-soft">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <h3>@cancelledReservations</h3>
                    <p>Cancelled</p>
                </div>
            </div>
        </div>

    </div>

    <div class="lms-card">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-bookmark-check"></i>
                Reservation Records
            </h3>

            <a asp-controller="Book" asp-action="Index" class="btn btn-lms-outline">
                <i class="bi bi-book me-1"></i>
                View Books
            </a>
        </div>

        <div class="lms-card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Reserved Date</th>
                                <th>Approved Date</th>
                                <th>Cancelled Date</th>
                                <th>Status</th>
                                <th>Book Availability</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int counter = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="#">@counter</td>

                                    <td data-label="Book">
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">
                                            @(item.Book?.Author ?? "Unknown Author")
                                        </div>
                                    </td>

                                    <td data-label="Member">
                                        <strong>@(item.ApplicationUser?.FullName ?? "Unknown Member")</strong>
                                        <div class="text-muted small">
                                            @(item.ApplicationUser?.Email ?? "")
                                        </div>
                                    </td>

                                    <td data-label="Reserved Date">
                                        @item.ReservationDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td data-label="Approved Date">
                                        @if (item.ApprovedDate.HasValue)
                                        {
                                            @item.ApprovedDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not approved</span>
                                        }
                                    </td>

                                    <td data-label="Cancelled Date">
                                        @if (item.CancelledDate.HasValue)
                                        {
                                            @item.CancelledDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not cancelled</span>
                                        }
                                    </td>

                                    <td data-label="Status">
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="status-badge badge-available">
                                                Approved / Issued
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="status-badge badge-unavailable">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Book Availability">
                                        @if (item.Book?.IsAvailable == true)
                                        {
                                            <span class="status-badge badge-available">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-unavailable">
                                                Unavailable
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Action">
                                        @if (item.Status == "Pending")
                                        {
                                            <div class="d-flex flex-wrap gap-2">

                                                @if (item.Book?.IsAvailable == true)
                                                {
                                                    <form asp-controller="Reservation"
                                                          asp-action="ApproveReservation"
                                                          method="post"
                                                          onsubmit="return confirm('Approve this reservation and issue the book to this member?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />

                                                        <button type="submit" class="btn btn-sm btn-lms-primary">
                                                            <i class="bi bi-check-circle me-1"></i>
                                                            Approve
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small d-inline-flex align-items-center">
                                                        <i class="bi bi-clock me-1"></i>
                                                        Waiting for return
                                                    </span>
                                                }

                                                <form asp-controller="Reservation"
                                                      asp-action="CancelByAdmin"
                                                      method="post"
                                                      onsubmit="return confirm('Cancel this reservation?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />

                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Cancel
                                                    </button>
                                                </form>

                                            </div>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="text-success fw-semibold">
                                                <i class="bi bi-check2-circle me-1"></i>
                                                Issued
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="text-danger fw-semibold">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Completed</span>
                                        }
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bookmark-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Reservations Found</h4>
                    <p class="text-muted mb-0">
                        Reservation requests will appear here when members reserve unavailable books.
                    </p>
                </div>
            }

        </div>
    </div>

</div>

<style>
    .reservation-kpi-card {
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .reservation-kpi-card h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
            color: #1f2d2a;
        }

        .reservation-kpi-card p {
            margin: 0;
            color: #6c7a74;
            font-weight: 600;
        }

    .stat-icon-box {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }

    .bg-warning-soft {
        background: #fff7e6;
        color: #b7791f;
    }
</style>