@model List<LibraryManagementSystem.Models.AdminMemberViewModel>

@{
    ViewData["Title"] = "Manage Members";
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Manage Members</h2>
        <p>View all registered library members created by the admin.</p>
        <div class="welcome-date">
            <i class="bi bi-people me-1"></i>
            Total Members: @Model.Count
        </div>
    </div>

    <div class="lms-card mb-4">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-people"></i>
                Member Records
            </h3>

            <a asp-controller="Admin" asp-action="CreateMember" class="btn btn-lms-primary">
                <i class="bi bi-person-plus"></i>
                Create Member
            </a>
        </div>

        <div class="lms-card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Role</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int counter = 1;
                            }

                            @foreach (var member in Model)
                            {
                                <tr>
                                    <td data-label="#">@counter</td>
                                    <td data-label="Full Name">
                                        <strong>@member.FullName</strong>
                                    </td>
                                    <td data-label="Email">@member.Email</td>
                                    <td data-label="Username">@member.UserName</td>
                                    <td data-label="Role">
                                        <span class="status-badge badge-available">Member</span>
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Members Found</h4>
                    <p class="text-muted">No member account has been created yet.</p>

                    <a asp-controller="Admin" asp-action="CreateMember" class="btn btn-lms-primary">
                        <i class="bi bi-person-plus"></i>
                        Create First Member
                    </a>
                </div>
            }

        </div>
    </div>

</div>