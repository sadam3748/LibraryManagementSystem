@{
    ViewData["Title"] = "Admin Dashboard";
    /*
     * ViewBag values from AdminController:
     *   ViewBag.TotalBooks         (int)
     *   ViewBag.TotalMembers       (int)
     *   ViewBag.ActiveBorrowings   (int)
     *   ViewBag.OverdueCount       (int)
     *   ViewBag.RecentTransactions (IEnumerable<BorrowTransaction>)
     */
    int overdueCount = ViewBag.OverdueCount ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                </h1>
                <p class="page-subtitle">Library overview and management centre</p>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </nav>
            </div>
            <div class="d-none d-md-flex gap-2">
                <a asp-controller="Reports" asp-action="Index" class="btn lms-btn-outline-nav">
                    <i class="bi bi-bar-chart-line me-1"></i>Reports
                </a>
                <a asp-controller="Book" asp-action="Create" class="btn btn-lms-gold btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Add Book
                </a>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-wrap">

    <!-- Overdue Alert Banner (shown only when overdue items exist) -->
    @if (overdueCount > 0)
    {
        <div class="lms-alert-error d-flex align-items-center gap-3 mb-4 rounded" style="border-radius:var(--radius-md)!important;">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <div class="flex-grow-1">
                <strong>@overdueCount overdue @(overdueCount == 1 ? "transaction" : "transactions")</strong> —
                some members have not returned their books by the due date.
            </div>
            <a asp-controller="BorrowTransaction" asp-action="Index" class="btn btn-lms-danger btn-sm flex-shrink-0">
                <i class="bi bi-eye me-1"></i>Review
            </a>
        </div>
    }

    <!-- Welcome Banner -->
    <div class="dashboard-welcome mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2>Welcome back, @User.Identity!.Name</h2>
                <p>Here is an overview of your library activity today.</p>
                <div class="welcome-date">
                    <i class="bi bi-calendar3 me-1"></i>
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </div>
            </div>
            <div class="d-none d-lg-block text-end" style="opacity:.5;">
                <i class="bi bi-building-fill-gear" style="font-size:3.5rem; color:var(--gold-light);"></i>
            </div>
        </div>
    </div>

    <!-- ── STAT BOXES ── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-box navy">
                <div class="stat-icon"><i class="bi bi-book-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.TotalBooks ?? 0)</div>
                    <div class="stat-label">Total Books</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box green">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.TotalMembers ?? 0)</div>
                    <div class="stat-label">Registered Members</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box info">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.ActiveBorrowings ?? 0)</div>
                    <div class="stat-label">Active Loans</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box danger">
                <div class="stat-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@overdueCount</div>
                    <div class="stat-label">Overdue</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── QUICK ACTIONS ── -->
    <div class="lms-card mb-4">
        <div class="lms-card-header">
            <h5 class="lms-card-title">
                <i class="bi bi-lightning-charge-fill"></i>Quick Actions
            </h5>
        </div>
        <div class="lms-card-body">
            <div class="quick-grid">
                <a asp-controller="Admin" asp-action="CreateMember" class="quick-btn">
                    <i class="bi bi-person-plus-fill"></i>Add Member
                </a>
                <a asp-controller="Admin" asp-action="Members" class="quick-btn">
                    <i class="bi bi-people"></i>
                    <span>Manage Members</span>
                </a>
                <a asp-controller="Book" asp-action="Create" class="quick-btn">
                    <i class="bi bi-plus-circle-fill"></i>Add Book
                </a>
                <a asp-controller="Book" asp-action="Index" class="quick-btn">
                    <i class="bi bi-journals"></i>All Books
                </a>
                <a asp-controller="BorrowTransaction" asp-action="Create" class="quick-btn">
                    <i class="bi bi-arrow-right-circle-fill"></i>Issue Book
                </a>
                <a asp-controller="BorrowTransaction" asp-action="Index" class="quick-btn">
                    <i class="bi bi-list-check"></i>Transactions
                </a>
                <a asp-controller="Reports" asp-action="Index" class="quick-btn">
                    <i class="bi bi-bar-chart-fill"></i>Reports
                </a>
                <a asp-controller="Account" asp-action="Profile" class="quick-btn">
                    <i class="bi bi-person-fill"></i>My Profile
                </a>
            </div>
        </div>
    </div>

    <!-- ── RECENT TRANSACTIONS ── -->
    <div class="lms-table-wrapper">
        <div class="lms-table-header">
            <h5 class="lms-table-title">
                <i class="bi bi-clock-history"></i>Recent Borrow Transactions
            </h5>
            <a asp-controller="BorrowTransaction" asp-action="Index" class="btn btn-lms-outline btn-sm">
                <i class="bi bi-arrow-right me-1"></i>View All
            </a>
        </div>
        <div class="table-responsive">
            <table class="lms-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Member</th>
                        <th>Book Title</th>
                        <th>Borrowed</th>
                        <th>Due Date</th>
                        <th>Returned</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentTransactions != null)
                    {
                        int sn = 1;
                        foreach (var tx in ViewBag.RecentTransactions)
                        {
                            bool isOverdue = tx.ReturnDate == null && tx.DueDate < DateTime.Today;
                            bool returned = tx.ReturnDate != null;
                            <tr>
                                <td data-label="#">@sn</td>
                                <td data-label="Member">
                                    <div style="font-weight:600; color:var(--navy); font-size:.86rem;">
                                        @tx.ApplicationUser?.FullName
                                    </div>
                                    <div style="font-size:.74rem; color:var(--grey-500);">
                                        @tx.ApplicationUser?.UserName
                                    </div>
                                </td>
                                <td data-label="Book Title">
                                    <span style="font-weight:600;">@tx.Book?.Title</span>
                                </td>
                                <td data-label="Borrowed">
                                    @tx.BorrowDate.ToString("MMM dd, yyyy")
                                </td>
                                <td data-label="Due Date" class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                    @tx.DueDate.ToString("MMM dd, yyyy")
                                    @if (isOverdue)
                                    {
                                        <div style="font-size:.72rem;">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Overdue
                                        </div>
                                    }
                                </td>
                                <td data-label="Returned">
                                    @(tx.ReturnDate.HasValue? tx.ReturnDate.Value.ToString("MMM dd, yyyy") : "—")
                                </td>
                                <td data-label="Status">
                                    @if (returned)
                                    {
                                        <span class="status-badge badge-returned">Returned</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="status-badge badge-overdue">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-borrowed">Borrowed</span>
                                    }
                                </td>
                            </tr>
                            sn++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox d-block mb-2" style="font-size:2.5rem; color:var(--grey-300);"></i>
                                <strong style="color:var(--grey-600);">No transactions yet</strong>
                                <div style="font-size:.82rem; color:var(--grey-500); margin-top:.3rem;">
                                    Issue your first book to get started.
                                </div>
                                <a asp-controller="BorrowTransaction" asp-action="Create"
                                   class="btn btn-lms-primary btn-sm mt-3">
                                    <i class="bi bi-arrow-right-circle me-1"></i>Issue a Book
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>