@{
    ViewData["Title"] = "Admin Dashboard";
    /*
     * Optional ViewBag values your AdminController can pass:
     *   ViewBag.TotalBooks         (int)
     *   ViewBag.TotalMembers       (int)
     *   ViewBag.ActiveBorrowings   (int)
     *   ViewBag.OverdueCount       (int)
     *   ViewBag.RecentTransactions (IEnumerable<BorrowTransaction>)
     * All fall back to static placeholders if null.
     */
}

<!-- Page Header -->
<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                </h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </nav>
            </div>
            <div class="d-none d-md-flex gap-2">
                <a asp-controller="Reports" asp-action="Index"
                   class="btn btn-sm"
                   style="border:1.5px solid rgba(255,255,255,.4);color:#fff;padding:.32rem .9rem;">
                    <i class="bi bi-bar-chart-line me-1"></i>Reports
                </a>
                <a asp-controller="Book" asp-action="Create" class="btn btn-lms-gold btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Add Book
                </a>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-wrap">

    <!-- Welcome Banner -->
    <div class="dashboard-welcome">
        <h2>Welcome back, @User.Identity!.Name! 👋</h2>
        <p>Here is an overview of your library activity.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar3 me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    <!-- ── STAT BOXES ── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-box navy">
                <div class="stat-icon"><i class="bi bi-book-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.TotalBooks ?? 0)</div>
                    <div class="stat-label">Total Books</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box green">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.TotalMembers ?? 0)</div>
                    <div class="stat-label">Members</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box info">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.ActiveBorrowings ?? 0)</div>
                    <div class="stat-label">Active Loans</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box danger">
                <div class="stat-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="stat-data">
                    <div class="stat-number">@(ViewBag.OverdueCount ?? 0)</div>
                    <div class="stat-label">Overdue</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── QUICK ACTIONS ── -->
    <div class="lms-card mb-4">
        <div class="lms-card-header">
            <h5 class="lms-card-title">
                <i class="bi bi-lightning-charge-fill"></i>Quick Actions
            </h5>
        </div>
        <div class="lms-card-body">
            <div class="quick-grid">
                <a asp-controller="Book" asp-action="Create" class="quick-btn">
                    <i class="bi bi-plus-circle-fill"></i>Add Book
                </a>
                <a asp-controller="Book" asp-action="Index" class="quick-btn">
                    <i class="bi bi-journals"></i>All Books
                </a>
                <a asp-controller="BorrowTransaction" asp-action="Create" class="quick-btn">
                    <i class="bi bi-arrow-right-circle-fill"></i>Issue Book
                </a>
                <a asp-controller="BorrowTransaction" asp-action="Index" class="quick-btn">
                    <i class="bi bi-list-check"></i>Transactions
                </a>
                <a asp-controller="Reports" asp-action="Index" class="quick-btn">
                    <i class="bi bi-bar-chart-fill"></i>Reports
                </a>
                <a asp-controller="Account" asp-action="Profile" class="quick-btn">
                    <i class="bi bi-person-fill"></i>Profile
                </a>
            </div>
        </div>
    </div>

    <!-- ── RECENT TRANSACTIONS ── -->
    <div class="lms-table-wrapper">
        <div class="lms-table-header">
            <h5 class="lms-table-title">
                <i class="bi bi-clock-history"></i>Recent Borrow Transactions
            </h5>
            <a asp-controller="BorrowTransaction" asp-action="Index"
               class="btn btn-lms-outline btn-sm">
                View All
            </a>
        </div>
        <div class="table-responsive">
            <table class="lms-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Member</th>
                        <th>Book</th>
                        <th>Borrow Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentTransactions != null)
                    {
                        int sn = 1;
                        foreach (var tx in ViewBag.RecentTransactions)
                        {
                            bool isOverdue = tx.ReturnDate == null
                                             && tx.DueDate < DateTime.Today;
                            bool returned  = tx.ReturnDate != null;

                            <tr>
                                <td data-label="#">@sn</td>
                                <td data-label="Member">@tx.ApplicationUser?.UserName</td>
                                <td data-label="Book">
                                    <strong>@tx.Book?.Title</strong>
                                </td>
                                <td data-label="Borrow Date">
                                    @tx.BorrowDate.ToString("MMM dd, yyyy")
                                </td>
                                <td data-label="Due Date"
                                    class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                    @tx.DueDate.ToString("MMM dd, yyyy")
                                </td>
                                <td data-label="Return Date">
                                    @(tx.ReturnDate.HasValue
                                        ? tx.ReturnDate.Value.ToString("MMM dd, yyyy")
                                        : "—")
                                </td>
                                <td data-label="Status">
                                    @if (returned)
                                    {
                                        <span class="status-badge badge-returned">Returned</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="status-badge badge-overdue">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-borrowed">Borrowed</span>
                                    }
                                </td>
                            </tr>
                            sn++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                                No recent transactions found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
