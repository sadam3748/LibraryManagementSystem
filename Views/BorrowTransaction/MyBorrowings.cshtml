@model List<LibraryManagementSystem.Models.BorrowTransaction>

@{
    ViewData["Title"] = "My Borrow History";

    var totalBorrowed = Model.Count;
    var currentlyBorrowed = Model.Count(x => x.Status == "Borrowed");
    var returnedBooks = Model.Count(x => x.Status == "Returned");
    var overdueBooks = Model.Count(x => x.Status == "Borrowed" && x.DueDate.Date < DateTime.Now.Date);
    var totalFine = Model.Sum(x => x.FineAmount);
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>My Borrow History</h2>
        <p>View your borrowed books, due dates, renewals, return status, and fine details.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-success-soft">
                        <i class="bi bi-book"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@totalBorrowed</h3>
                        <p class="text-muted mb-0">Total Borrowed</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-primary-soft">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@currentlyBorrowed</h3>
                        <p class="text-muted mb-0">Currently Borrowed</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-success-soft">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@returnedBooks</h3>
                        <p class="text-muted mb-0">Returned Books</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="lms-card h-100">
                <div class="lms-card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-box bg-danger-soft">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">@overdueBooks</h3>
                        <p class="text-muted mb-0">Overdue Books</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-4">
            <div class="lms-card h-100">
                <div class="lms-card-header">
                    <h3 class="lms-card-title">
                        <i class="bi bi-cash-coin"></i>
                        Fine Summary
                    </h3>
                </div>

                <div class="lms-card-body">
                    <h2 class="fw-bold text-danger mb-2">
                        @totalFine.ToString("C")
                    </h2>
                    <p class="text-muted mb-0">
                        Total fine amount linked with your borrowing records.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="lms-card h-100">
                <div class="lms-card-header">
                    <h3 class="lms-card-title">
                        <i class="bi bi-info-circle"></i>
                        Borrowing Rules
                    </h3>
                </div>

                <div class="lms-card-body">
                    <p class="text-muted mb-2">
                        Books must be returned before the due date. Active books can be renewed only within the allowed renewal limit set by the library admin.
                    </p>
                    <a asp-controller="Book" asp-action="Index" class="btn btn-lms-primary mt-2">
                        <i class="bi bi-search me-1"></i>
                        Browse More Books
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="lms-card">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-clock-history"></i>
                Borrowing Records
            </h3>

            <a asp-controller="Book" asp-action="Index" class="btn btn-lms-outline">
                <i class="bi bi-search me-1"></i>
                Browse Books
            </a>
        </div>

        <div class="lms-card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Borrow Date</th>
                                <th>Due Date</th>
                                <th>Return Date</th>
                                <th>Renew Count</th>
                                <th>Status</th>
                                <th>Fine</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int counter = 1;
                            }

                            @foreach (var item in Model)
                            {
                                var isOverdue = item.Status == "Borrowed" && item.DueDate.Date < DateTime.Now.Date;

                                <tr>
                                    <td data-label="#">@counter</td>

                                    <td data-label="Book">
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">
                                            @(item.Book?.Author ?? "Unknown Author")
                                        </div>
                                    </td>

                                    <td data-label="Borrow Date">
                                        @item.BorrowDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td data-label="Due Date">
                                        @item.DueDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td data-label="Return Date">
                                        @if (item.ReturnDate.HasValue)
                                        {
                                            @item.ReturnDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not returned</span>
                                        }
                                    </td>

                                    <td data-label="Renew Count">
                                        <span class="status-badge badge-pending">
                                            @item.RenewCount
                                        </span>
                                    </td>

                                    <td data-label="Status">
                                        @if (item.Status == "Returned")
                                        {
                                            <span class="status-badge badge-available">
                                                Returned
                                            </span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="status-badge badge-unavailable">
                                                Overdue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">
                                                Borrowed
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Fine">
                                        @if (item.FineAmount > 0)
                                        {
                                            <strong class="text-danger">
                                                @item.FineAmount.ToString("C")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No fine</span>
                                        }
                                    </td>

                                    <td data-label="Action">
                                        @if (item.Status == "Borrowed" && !isOverdue)
                                        {
                                            <form asp-controller="BorrowTransaction"
                                                  asp-action="RenewBook"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to renew this book?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit" class="btn btn-sm btn-lms-primary">
                                                    <i class="bi bi-arrow-repeat me-1"></i>
                                                    Renew
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="text-muted">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small">Return required</span>
                                        }
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Borrowing Records</h4>
                    <p class="text-muted">
                        You have not borrowed any book yet.
                    </p>

                    <a asp-controller="Book" asp-action="Index" class="btn btn-lms-primary">
                        <i class="bi bi-search me-1"></i>
                        Browse Books
                    </a>
                </div>
            }

        </div>
    </div>

</div>

<style>
    .stat-icon-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }
</style>