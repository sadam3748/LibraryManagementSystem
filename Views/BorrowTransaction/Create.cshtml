@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Borrow Book";

    int loanDurationDays = ViewBag.LoanDurationDays ?? 14;
    DateTime dueDate = ViewBag.DueDate ?? DateTime.Now.AddDays(loanDurationDays);
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Borrow Book</h2>
        <p>Confirm that you want to borrow this book from the library.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-check me-1"></i>
            Due date will be @loanDurationDays day(s) from today
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="lms-card">
                <div class="lms-card-header">
                    <h3 class="lms-card-title">
                        <i class="bi bi-book"></i>
                        Book Details
                    </h3>

                    <span class="status-badge badge-available">
                        Available
                    </span>
                </div>

                <div class="lms-card-body">

                    <div class="row g-4 align-items-start">

                        <div class="col-md-4">
                            <div class="book-cover-box">
                                @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                                {
                                    <img src="@Model.CoverImage" alt="@Model.Title" class="img-fluid rounded-3" />
                                }
                                else
                                {
                                    <div class="book-cover-placeholder">
                                        <i class="bi bi-book"></i>
                                        <span>No Cover</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-8">
                            <h3 class="fw-bold mb-2">@Model.Title</h3>

                            <p class="text-muted mb-3">
                                by <strong>@Model.Author</strong>
                            </p>

                            <div class="detail-list">

                                <div class="detail-row">
                                    <span>Genre</span>
                                    <strong>@Model.Genre</strong>
                                </div>

                                <div class="detail-row">
                                    <span>ISBN</span>
                                    <strong>@Model.ISBN</strong>
                                </div>

                                <div class="detail-row">
                                    <span>Publisher</span>
                                    <strong>@Model.Publisher</strong>
                                </div>

                                <div class="detail-row">
                                    <span>Published Year</span>
                                    <strong>@Model.PublishedYear</strong>
                                </div>

                                <div class="detail-row">
                                    <span>Edition</span>
                                    <strong>@Model.Edition</strong>
                                </div>

                                <div class="detail-row">
                                    <span>Borrow Date</span>
                                    <strong>@DateTime.Now.ToString("dd MMM yyyy")</strong>
                                </div>

                                <div class="detail-row">
                                    <span>Due Date</span>
                                    <strong>@dueDate.ToString("dd MMM yyyy")</strong>
                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <div class="mt-4">
                                    <h5 class="fw-bold">Description</h5>
                                    <p class="text-muted mb-0">@Model.Description</p>
                                </div>
                            }

                            <div class="alert alert-info mt-4 mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                This book must be returned within <strong>@loanDurationDays day(s)</strong>.
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <form asp-controller="BorrowTransaction" asp-action="CreateConfirmed" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@Model.Id" />

                                    <button type="submit" class="btn btn-lms-primary">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Confirm Borrow
                                    </button>
                                </form>

                                <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back to Book Details
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

<style>
    .book-cover-box {
        background: #f6f8f7;
        border: 1px solid #dbe7df;
        border-radius: 16px;
        padding: 16px;
        min-height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-cover-placeholder {
        width: 100%;
        min-height: 220px;
        border-radius: 14px;
        background: #eaf5ef;
        color: #2e7d5e;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .book-cover-placeholder i {
            font-size: 3rem;
            margin-bottom: 10px;
        }

    .detail-list {
        border: 1px solid #dbe7df;
        border-radius: 14px;
        overflow: hidden;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 12px 16px;
        border-bottom: 1px solid #dbe7df;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span {
            color: #6c7a74;
            font-weight: 600;
        }

        .detail-row strong {
            color: #1f2d2a;
            text-align: right;
        }
</style>