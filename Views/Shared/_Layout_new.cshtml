<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LibraSystem — Smart Library Management for members and administrators." />
    <title>@ViewData["Title"] - LibraSystem</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg lms-navbar">
        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand lms-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-book-half"></i></span>
                <span class="brand-text">Libra<span class="brand-accent">System</span></span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler lms-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                @* ── GUEST ── *@
                @if (!User.Identity!.IsAuthenticated)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : "")"
                               asp-controller="Book" asp-action="Index">
                                <i class="bi bi-journals me-1"></i>Browse Books
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto gap-2 align-items-center">
                        <li class="nav-item">
                            <a class="btn lms-btn-outline-nav" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn lms-btn-primary-nav" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    </ul>
                }

                @* ── ADMIN ── *@
                @if (User.IsInRole("Admin"))
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                               asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link lms-nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : "")"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-journals me-1"></i>Books
                            </a>
                            <ul class="dropdown-menu lms-dropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Book" asp-action="Index">
                                        <i class="bi bi-list-ul me-2"></i>All Books
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Book" asp-action="Create">
                                        <i class="bi bi-plus-circle me-2"></i>Add New Book
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BorrowTransaction" ? "active" : "")"
                               asp-controller="BorrowTransaction" asp-action="Index">
                                <i class="bi bi-arrow-left-right me-1"></i>Transactions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                               asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-line me-1"></i>Reports
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item">
                            <span class="lms-role-badge admin-badge">
                                <i class="bi bi-shield-check me-1"></i>Admin
                            </span>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link lms-user-menu dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-avatar"><i class="bi bi-person-circle"></i></span>
                                <span class="user-name">@User.Identity!.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end lms-dropdown">
                                <li>
                                    <div class="px-3 py-2" style="font-size:.75rem; color:var(--grey-500); line-height:1.3;">
                                        Signed in as<br />
                                        <strong style="color:var(--grey-700); font-size:.82rem;">@User.Identity!.Name</strong>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i>My Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item" style="color:var(--danger);">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }

                @* ── MEMBER ── *@
                @if (User.Identity!.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Member" ? "active" : "")"
                               asp-controller="Member" asp-action="Dashboard">
                                <i class="bi bi-grid me-1"></i>My Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : "")"
                               asp-controller="Book" asp-action="Index">
                                <i class="bi bi-search me-1"></i>Browse Books
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BorrowTransaction" ? "active" : "")"
                               asp-controller="BorrowTransaction" asp-action="MyHistory">
                                <i class="bi bi-clock-history me-1"></i>My History
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item">
                            <span class="lms-role-badge member-badge">
                                <i class="bi bi-person-badge me-1"></i>Member
                            </span>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link lms-user-menu dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-avatar"><i class="bi bi-person-circle"></i></span>
                                <span class="user-name">@User.Identity!.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end lms-dropdown">
                                <li>
                                    <div class="px-3 py-2" style="font-size:.75rem; color:var(--grey-500); line-height:1.3;">
                                        Signed in as<br />
                                        <strong style="color:var(--grey-700); font-size:.82rem;">@User.Identity!.Name</strong>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i>My Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item" style="color:var(--danger);">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }

            </div>
        </div>
    </nav>

    <!-- ========== GLOBAL ALERTS ========== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="lms-alert-success alert-dismissible fade show d-flex align-items-center gap-2 px-4 py-2" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
            <span class="flex-grow-1">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close btn-close-sm ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="lms-alert-error alert-dismissible fade show d-flex align-items-center gap-2 px-4 py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <span class="flex-grow-1">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close btn-close-sm ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ========== MAIN CONTENT ========== -->
    <main class="lms-main">
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="lms-footer">
        <div class="container-fluid px-4">
            <div class="row align-items-center gy-2">
                <div class="col-md-4">
                    <div class="footer-brand">
                        <i class="bi bi-book-half me-2"></i><strong>LibraSystem</strong>
                    </div>
                    <p class="footer-tagline">Smart Library Management</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span class="divider">·</span>
                        <a asp-controller="Book" asp-action="Index">Books</a>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <span class="divider">·</span>
                            <a asp-controller="Account" asp-action="Profile">Profile</a>
                        }
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="footer-copy">&copy; @DateTime.Now.Year LibraSystem &mdash; Student Project</p>
                    <p class="footer-tech">ASP.NET Core MVC &bull; EF Core &bull; SQL Server</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>