<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraSystem</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg lms-navbar">
        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand lms-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">
                    <i class="bi bi-book-half"></i>
                </span>
                <span class="brand-text">
                    Libra<span class="brand-accent">System</span>
                </span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler lms-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- LEFT MENU -->
                <ul class="navbar-nav me-auto align-items-lg-center">

                    @* GUEST MENU *@
                    @if (User.Identity == null || !User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-journals me-1"></i>
                                Browse Books
                            </a>
                        </li>
                    }

                    @* ADMIN MENU *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-book me-1"></i>
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Admin" asp-action="Members">
                                <i class="bi bi-people me-1"></i>
                                Members
                            </a>
                        </li>
                        @*
                 Hide this Menu for week 1
                *@
                      

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="BorrowTransaction" asp-action="Index">
                                <i class="bi bi-arrow-left-right me-1"></i>
                                Transactions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Reservation" asp-action="Index">
                                <i class="bi bi-bookmark-check me-1"></i>
                                Reservations
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="BorrowingSetting" asp-action="Index">
                                <i class="bi bi-gear-fill me-1"></i>
                                Settings
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart me-1"></i>
                                Reports
                            </a>
                        </li>

            
                    }

                    @* MEMBER MENU *@
                    @if (User.IsInRole("Member"))
                    {
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Member" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-search me-1"></i>
                                Browse Books
                            </a>
                        </li>
                @*
                 Hide this Menu for week 1
                *@
                       

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="BorrowTransaction" asp-action="MyBorrowings">
                                <i class="bi bi-clock-history me-1"></i>
                                My Borrowings
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Reservation" asp-action="MyReservations">
                                <i class="bi bi-bookmark-check me-1"></i>
                                My Reservations
                            </a>
                        </li>

                       
                    }

                </ul>

                <!-- RIGHT ACCOUNT MENU -->
                <ul class="navbar-nav ms-auto align-items-lg-center">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center">
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="role-badge admin-badge">
                                    <i class="bi bi-shield-check me-1"></i>
                                    ADMIN
                                </span>
                            }
                            else if (User.IsInRole("Member"))
                            {
                                <span class="role-badge member-badge">
                                    <i class="bi bi-person-badge me-1"></i>
                                    MEMBER
                                </span>
                            }
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-menu-link"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-person-circle user-avatar-icon me-1"></i>
                                <span>@User.Identity.Name</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i>
                                        My Profile
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="CreateMember">
                                            <i class="bi bi-person-plus me-2"></i>
                                            Create Member
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole("Member"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Member" asp-action="Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>
                                @*
                 Hide this Menu for week 1
                *@
                        <div style="display:none;">
                                    <li>
                                        <a class="dropdown-item" asp-controller="BorrowTransaction" asp-action="MyBorrowings">
                                            <i class="bi bi-clock-history me-2"></i>
                                            My Borrowings
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Reservation" asp-action="MyReservations">
                                            <i class="bi bi-bookmark-check me-2"></i>
                                            My Reservations
                                        </a>
                                    </li>

                                    </div>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link lms-nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn lms-btn-primary-nav" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>
                                Register
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- ========== TEMP ALERTS ========== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert lms-alert-success alert-dismissible fade show m-0" role="alert">
            <div class="container-fluid px-4">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert lms-alert-error alert-dismissible fade show m-0" role="alert">
            <div class="container-fluid px-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- ========== MAIN CONTENT ========== -->
    <main class="lms-main">
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="lms-footer">
        <div class="container-fluid px-4">
            <div class="row align-items-center">

                <div class="col-md-4">
                    <div class="footer-brand">
                        <i class="bi bi-book-half me-2"></i>
                        <strong>LibraSystem</strong>
                    </div>
                    <p class="footer-tagline">Smart Library Management</p>
                </div>

                <div class="col-md-4 text-center">
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span class="divider">·</span>
                        <a asp-controller="Book" asp-action="Index">Books</a>
                    </div>
                </div>

                <div class="col-md-4 text-md-end">
                    <p class="footer-copy">
                        &copy; @DateTime.Now.Year LibraSystem &mdash; Student Project
                    </p>
                    <p class="footer-tech">
                        ASP.NET Core MVC &bull; EF Core &bull; SQL Server
                    </p>
                </div>

            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>