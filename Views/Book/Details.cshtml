@model LibraryManagementSystem.Models.Book
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin      = User.IsInRole("Admin");
    bool isMember     = User.IsInRole("Member");
    bool isAvailable  = Model.IsAvailable;
}

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-book me-2"></i>Book Details
                </h1>
                <p class="page-subtitle">@Model.Title — full information and availability</p>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Book" asp-action="Index">Books</a>
                        </li>
                        <li class="breadcrumb-item active">@Model.Title</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Book" asp-action="Index" class="btn lms-btn-outline-nav">
                    <i class="bi bi-arrow-left me-1"></i>Back to Books
                </a>
                @if (isAdmin)
                {
                    <a asp-controller="Book" asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-lms-gold btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit Book
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── BODY ── -->
<div class="dashboard-wrap">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="container-fluid px-0">
        <div class="row g-4 mx-0">

            <!-- ══ LEFT COLUMN: Cover + Actions ══ -->
            <div class="col-lg-3 col-md-4">

                <!-- Book Cover -->
                <div class="detail-cover mb-3" style="border-radius: var(--radius-lg);">
                    <i class="bi bi-book-half"></i>
                    <div style="position:absolute; top:12px; right:12px;">
                        @if (isAvailable)
                        {
                            <span class="status-badge badge-available">Available</span>
                        }
                        else
                        {
                            <span class="status-badge badge-borrowed">Borrowed</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Genre))
                    {
                        <div style="position:absolute; bottom:12px; left:12px;">
                            <span class="book-genre-tag">@Model.Genre</span>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                @if (isAdmin)
                {
                    <div class="lms-card mb-3">
                        <div class="lms-card-header">
                            <h5 class="lms-card-title" style="font-size:.82rem;">
                                <i class="bi bi-lightning-charge-fill"></i>Admin Actions
                            </h5>
                        </div>
                        <div class="lms-card-body d-grid gap-2">
                            @if (isAvailable)
                            {
                                <a asp-controller="BorrowTransaction"
                                   asp-action="Create"
                                   asp-route-bookId="@Model.Id"
                                   class="btn btn-lms-primary">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    Issue This Book
                                </a>
                            }
                            else
                            {
                                <a href="#"
                                   class="btn btn-lms-primary disabled"
                                   aria-disabled="true">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Book Not Available
                                </a>
                            }
                            <a asp-controller="Book" asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-lms-secondary">
                                <i class="bi bi-pencil me-1"></i>Edit Book
                            </a>
                            <a asp-controller="Book" asp-action="Delete" asp-route-id="@Model.Id"
                               class="btn btn-lms-danger">
                                <i class="bi bi-trash me-1"></i>Delete Book
                            </a>
                        </div>
                    </div>
                }

                @if (isMember)
                {
                    <div class="lms-card mb-3">
                        <div class="lms-card-header">
                            <h5 class="lms-card-title" style="font-size:.82rem;">
                                <i class="bi bi-lightning-charge-fill"></i>Member Actions
                            </h5>
                        </div>

                        <div class="lms-card-body d-grid gap-2">
                            @if (isAvailable)
                            {
                                <a asp-controller="BorrowTransaction"
                                   asp-action="Create"
                                   asp-route-bookId="@Model.Id"
                                   class="btn btn-lms-primary">
                                    <i class="bi bi-bookmark-plus me-1"></i>
                                    Borrow This Book
                                </a>
                            }
                            else
                            {
                                <form asp-controller="Reservation"
                                      asp-action="ReserveBook"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@Model.Id" />

                                    <button type="submit" class="btn btn-lms-primary w-100">
                                        <i class="bi bi-bookmark-check me-1"></i>
                                        Reserve This Book
                                    </button>
                                </form>

                                <p class="mb-0 text-center" style="font-size:.75rem; color:var(--grey-500);">
                                    <i class="bi bi-info-circle me-1"></i>
                                    This book is currently on loan. You can reserve it.
                                </p>
                            }

                            <a asp-controller="Reservation"
                               asp-action="MyReservations"
                               class="btn btn-lms-outline">
                                <i class="bi bi-bookmark me-1"></i>
                                My Reservations
                            </a>

                            <a asp-controller="Book"
                               asp-action="Index"
                               class="btn btn-lms-outline">
                                <i class="bi bi-search me-1"></i>
                                Browse More Books
                            </a>
                        </div>
                    </div>
                }

              <!-- Quick Stats Tile -->
                <div class="lms-card">
                    <div class="lms-card-body">
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <span style="font-size:.77rem; color:var(--grey-500);
                                             text-transform:uppercase; letter-spacing:.4px; font-weight:600;">
                                    Status
                                </span>
                                @if (isAvailable)
                                {
                                    <span class="status-badge badge-available">Available</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-borrowed">Borrowed</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Genre))
                            {
                                <div class="d-flex align-items-center justify-content-between">
                                    <span style="font-size:.77rem; color:var(--grey-500);
                                                 text-transform:uppercase; letter-spacing:.4px; font-weight:600;">
                                        Genre
                                    </span>
                                    <span style="font-size:.83rem; font-weight:600; color:var(--navy);">
                                        @Model.Genre
                                    </span>
                                </div>
                            }
                            @if (Model.PublishedYear.HasValue)
                            {
                                <div class="d-flex align-items-center justify-content-between">
                                    <span style="font-size:.77rem; color:var(--grey-500);
                                                 text-transform:uppercase; letter-spacing:.4px; font-weight:600;">
                                        Year
                                    </span>
                                    <span style="font-size:.83rem; font-weight:600; color:var(--navy);">
                                        @Model.PublishedYear
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- ══ RIGHT COLUMN: Book Info ══ -->
            <div class="col-lg-9 col-md-8">

                <!-- Title Block -->
                <div class="lms-card mb-4">
                    <div class="lms-card-body">
                        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                            <div>
                                <h2 style="font-family:var(--font-display); font-size:1.75rem;
                                            font-weight:700; color:var(--navy); margin-bottom:.3rem;
                                            line-height:1.25;">
                                    @Model.Title
                                </h2>
                                <p class="mb-0" style="font-size:.97rem; color:var(--grey-600);">
                                    <i class="bi bi-person-fill me-1 text-green"></i>
                                    by <strong style="color:var(--navy);">@Model.Author</strong>
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Publisher))
                                {
                                    <p class="mb-0 mt-1" style="font-size:.83rem; color:var(--grey-500);">
                                        <i class="bi bi-building me-1"></i>@Model.Publisher
                                        @if (!string.IsNullOrEmpty(Model.Edition))
                                        {
                                            <span class="mx-1" style="color:var(--grey-300);">·</span>
                                            <span>@Model.Edition Edition</span>
                                        }
                                    </p>
                                }
                            </div>
                            <div class="flex-shrink-0">
                                @if (isAvailable)
                                {
                                    <span class="status-badge badge-available" style="font-size:.78rem; padding:.3rem .85rem;">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge badge-borrowed" style="font-size:.78rem; padding:.3rem .85rem;">
                                        Borrowed
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="lms-card mb-4">
                        <div class="lms-card-header">
                            <h5 class="lms-card-title">
                                <i class="bi bi-file-text"></i>About This Book
                            </h5>
                        </div>
                        <div class="lms-card-body">
                            <p style="color:var(--grey-700); line-height:1.85; margin:0;
                                       font-size:.93rem;">
                                @Model.Description
                            </p>
                        </div>
                    </div>
                }

                <!-- Book Information Table -->
                <div class="lms-card">
                    <div class="lms-card-header">
                        <h5 class="lms-card-title">
                            <i class="bi bi-info-circle"></i>Book Information
                        </h5>
                    </div>
                    <div class="lms-card-body pb-1">
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="info-list">
                                    <li>
                                        <span class="info-label">Title</span>
                                        <span class="info-value fw-semibold">@Model.Title</span>
                                    </li>
                                    <li>
                                        <span class="info-label">Author</span>
                                        <span class="info-value">@Model.Author</span>
                                    </li>
                                    <li>
                                        <span class="info-label">ISBN</span>
                                        <span class="info-value"
                                              style="font-family: monospace; font-size:.85rem;
                                                     letter-spacing:.3px;">
                                            @(Model.ISBN ?? "Not recorded")
                                        </span>
                                    </li>
                                    <li>
                                        <span class="info-label">Genre</span>
                                        <span class="info-value">@(Model.Genre ?? "Not recorded")</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="info-list">
                                    <li>
                                        <span class="info-label">Publisher</span>
                                        <span class="info-value">@(Model.Publisher ?? "Not recorded")</span>
                                    </li>
                                    <li>
                                        <span class="info-label">Edition</span>
                                        <span class="info-value">@(Model.Edition ?? "Not recorded")</span>
                                    </li>
                                    <li>
                                        <span class="info-label">Published</span>
                                        <span class="info-value">
                                            @(Model.PublishedYear.HasValue
                                                ? Model.PublishedYear.ToString()
                                                : "Not recorded")
                                        </span>
                                    </li>
                                    <li>
                                        <span class="info-label">Status</span>
                                        <span class="info-value">
                                            @if (isAvailable)
                                            {
                                                <span class="status-badge badge-available">Available</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge badge-borrowed">Borrowed</span>
                                            }
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer with nav actions -->
                    <div class="lms-card-footer d-flex gap-2 flex-wrap">
                        <a asp-controller="Book" asp-action="Index" class="btn btn-lms-outline btn-sm">
                            <i class="bi bi-arrow-left me-1"></i>All Books
                        </a>
                        @if (isAdmin)
                        {
                            <a asp-controller="Book" asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-lms-gold btn-sm ms-auto">
                                <i class="bi bi-pencil me-1"></i>Edit This Book
                            </a>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>