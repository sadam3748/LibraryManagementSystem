@model LibraryManagementSystem.Models.Book
@{
    ViewData["Title"] = "Delete Book";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container-fluid px-4">
        <h1 class="page-title"><i class="bi bi-trash me-2"></i>Delete Book</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Book" asp-action="Index">Books</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.Id">
                        @Model.Title
                    </a>
                </li>
                <li class="breadcrumb-item active">Delete</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="delete-card">
                <!-- Delete Warning Header -->
                <div class="delete-head">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <h4>Confirm Deletion</h4>
                        <small style="color:var(--danger);font-size:.8rem;">
                            This action cannot be undone.
                        </small>
                    </div>
                </div>

                <!-- Book Summary -->
                <div class="delete-body">
                    <p style="color:var(--grey-700);margin-bottom:1.2rem;">
                        You are about to permanently delete the following book record from the library catalog.
                        Please confirm this is the correct book before proceeding.
                    </p>

                    <!-- Book Info Card -->
                    <div style="background:var(--grey-50);border:1px solid var(--grey-200);
                                border-radius:var(--radius-md);padding:1.1rem 1.3rem;margin-bottom:1.4rem;">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div style="width:48px;height:60px;
                                        background:linear-gradient(135deg,var(--navy),var(--navy-light));
                                        border-radius:6px;display:grid;place-items:center;flex-shrink:0;">
                                <i class="bi bi-book-fill"
                                   style="color:rgba(255,255,255,.35);font-size:1.3rem;"></i>
                            </div>
                            <div>
                                <div style="font-family:var(--font-display);font-size:1.1rem;
                                            font-weight:700;color:var(--navy);">
                                    @Model.Title
                                </div>
                                <div style="font-size:.85rem;color:var(--grey-600);">
                                    <i class="bi bi-person-fill me-1"></i>@Model.Author
                                </div>
                            </div>
                        </div>

                        <ul class="info-list">
                            <li>
                                <span class="info-label">ISBN</span>
                                <span class="info-value"
                                      style="font-family:monospace;">@(Model.ISBN ?? "N/A")</span>
                            </li>
                            <li>
                                <span class="info-label">Genre</span>
                                <span class="info-value">@(Model.Genre ?? "N/A")</span>
                            </li>
                            <li>
                                <span class="info-label">Publisher</span>
                                <span class="info-value">@(Model.Publisher ?? "N/A")</span>
                            </li>
                            <li>
                                <span class="info-label">Year</span>
                                <span class="info-value">
                                    @(Model.PublishedYear.HasValue ? Model.PublishedYear.ToString() : "N/A")
                                </span>
                            </li>
                            <li>
                                <span class="info-label">Status</span>
                                <span class="info-value">
                                    @if (Model.IsAvailable)
                                    {
                                        <span class="status-badge badge-available">Available</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-borrowed">Currently Borrowed</span>
                                    }
                                </span>
                            </li>
                        </ul>
                    </div>

                    @if (!Model.IsAvailable)
                    {
                        <div class="lms-alert-error mb-3" style="border-radius:var(--radius-sm);">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Warning:</strong> This book is currently borrowed.
                            Deleting it may affect active borrowing records.
                        </div>
                    }

                    <!-- Delete Form -->
                    <form asp-controller="Book" asp-action="Delete" asp-route-id="@Model.Id"
                          method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.Id"
                               class="btn"
                               style="border:1.5px solid var(--grey-300);
                                      color:var(--grey-700);padding:.48rem 1.1rem;">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </a>
                            <a asp-controller="Book" asp-action="Index"
                               class="btn btn-lms-secondary">
                                <i class="bi bi-list-ul me-1"></i>All Books
                            </a>
                            <button type="submit" class="btn btn-lms-danger px-4">
                                <i class="bi bi-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
