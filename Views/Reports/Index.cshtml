@using LibraryManagementSystem.Models
@using LibraryManagementSystem.Controllers

@{
    ViewData["Title"] = "Reports";

    var totalBooks = ViewBag.TotalBooks ?? 0;
    var availableBooks = ViewBag.AvailableBooks ?? 0;
    var unavailableBooks = ViewBag.UnavailableBooks ?? 0;
    var totalMembers = ViewBag.TotalMembers ?? 0;
    var totalTransactions = ViewBag.TotalTransactions ?? 0;
    var activeLoans = ViewBag.ActiveLoans ?? 0;
    var returnedBooks = ViewBag.ReturnedBooks ?? 0;
    var overdueBooks = ViewBag.OverdueBooks ?? 0;
    var totalFineAmount = ViewBag.TotalFineAmount ?? 0;

    var totalReservations = ViewBag.TotalReservations ?? 0;
    var pendingReservations = ViewBag.PendingReservations ?? 0;
    var approvedReservations = ViewBag.ApprovedReservations ?? 0;
    var cancelledReservations = ViewBag.CancelledReservations ?? 0;

    var recentTransactions = ViewBag.RecentTransactions as List<BorrowTransaction> ?? new List<BorrowTransaction>();
    var recentReservations = ViewBag.RecentReservations as List<Reservation> ?? new List<Reservation>();
    var mostBorrowedBooks = ViewBag.MostBorrowedBooks as List<MostBorrowedBookReportViewModel> ?? new List<MostBorrowedBookReportViewModel>();
}

<div class="dashboard-wrap">

    <div class="dashboard-welcome">
        <h2>Library Reports</h2>
        <p>View overall library performance, book availability, transactions, reservations, and fine summary.</p>
        <div class="welcome-date">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <h3>@totalBooks</h3>
                    <p>Total Books</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <h3>@availableBooks</h3>
                    <p>Available Books</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-danger-soft">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <h3>@unavailableBooks</h3>
                    <p>Unavailable Books</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-primary-soft">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h3>@totalMembers</h3>
                    <p>Total Members</p>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-primary-soft">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div>
                    <h3>@totalTransactions</h3>
                    <p>Total Transactions</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <h3>@activeLoans</h3>
                    <p>Active Borrowings</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-check2-square"></i>
                </div>
                <div>
                    <h3>@returnedBooks</h3>
                    <p>Returned Books</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-danger-soft">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h3>@overdueBooks</h3>
                    <p>Overdue Books</p>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-primary-soft">
                    <i class="bi bi-bookmark-check"></i>
                </div>
                <div>
                    <h3>@totalReservations</h3>
                    <p>Total Reservations</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-warning-soft">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h3>@pendingReservations</h3>
                    <p>Pending Reservations</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-success-soft">
                    <i class="bi bi-bookmark-check-fill"></i>
                </div>
                <div>
                    <h3>@approvedReservations</h3>
                    <p>Approved Reservations</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="lms-card h-100 report-kpi-card">
                <div class="stat-icon-box bg-danger-soft">
                    <i class="bi bi-bookmark-x"></i>
                </div>
                <div>
                    <h3>@cancelledReservations</h3>
                    <p>Cancelled Reservations</p>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-4">
            <div class="lms-card h-100">
                <div class="lms-card-header">
                    <h3 class="lms-card-title">
                        <i class="bi bi-cash-coin"></i>
                        Fine Summary
                    </h3>
                </div>
                <div class="lms-card-body">
                    <h2 class="fw-bold text-danger mb-2">
                        @Convert.ToDecimal(totalFineAmount).ToString("C")
                    </h2>
                    <p class="text-muted mb-0">
                        Total fine amount recorded from overdue or returned transactions.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="lms-card h-100">
                <div class="lms-card-header">
                    <h3 class="lms-card-title">
                        <i class="bi bi-bar-chart-line"></i>
                        Most Borrowed Books
                    </h3>
                </div>

                <div class="lms-card-body">
                    @if (mostBorrowedBooks.Any())
                    {
                        <div class="table-responsive">
                            <table class="lms-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Book</th>
                                        <th>Author</th>
                                        <th>Borrow Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int mostCounter = 1;
                                    }

                                    @foreach (var item in mostBorrowedBooks)
                                    {
                                        <tr>
                                            <td>@mostCounter</td>
                                            <td><strong>@item.BookTitle</strong></td>
                                            <td>@item.BookAuthor</td>
                                            <td>
                                                <span class="status-badge badge-available">
                                                    @item.BorrowCount time(s)
                                                </span>
                                            </td>
                                        </tr>

                                        mostCounter++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-bar-chart text-muted" style="font-size: 2.5rem;"></i>
                            <h5 class="mt-3">No Borrowing Data</h5>
                            <p class="text-muted mb-0">Most borrowed books will appear after transactions are recorded.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="lms-card mb-4">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-clock-history"></i>
                Recent Borrow Transactions
            </h3>

            <a asp-controller="BorrowTransaction" asp-action="Index" class="btn btn-lms-outline">
                View All
            </a>
        </div>

        <div class="lms-card-body">
            @if (recentTransactions.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Borrow Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Fine</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int transactionCounter = 1;
                            }

                            @foreach (var item in recentTransactions)
                            {
                                var isOverdue = item.Status == "Borrowed" && item.DueDate.Date < DateTime.Now.Date;

                                <tr>
                                    <td>@transactionCounter</td>
                                    <td>
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">@(item.Book?.Author ?? "Unknown Author")</div>
                                    </td>
                                    <td>
                                        <strong>@(item.ApplicationUser?.FullName ?? "Unknown Member")</strong>
                                        <div class="text-muted small">@(item.ApplicationUser?.Email ?? "")</div>
                                    </td>
                                    <td>@item.BorrowDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (item.Status == "Returned")
                                        {
                                            <span class="status-badge badge-available">Returned</span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="status-badge badge-unavailable">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">Borrowed</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.FineAmount > 0)
                                        {
                                            <strong class="text-danger">@item.FineAmount.ToString("C")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No fine</span>
                                        }
                                    </td>
                                </tr>

                                transactionCounter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clock-history text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Recent Transactions</h4>
                    <p class="text-muted mb-0">Borrowing records will appear here.</p>
                </div>
            }
        </div>
    </div>

    <div class="lms-card">
        <div class="lms-card-header">
            <h3 class="lms-card-title">
                <i class="bi bi-bookmark-check"></i>
                Recent Reservations
            </h3>

            <a asp-controller="Reservation" asp-action="Index" class="btn btn-lms-outline">
                View All
            </a>
        </div>

        <div class="lms-card-body">
            @if (recentReservations.Any())
            {
                <div class="table-responsive">
                    <table class="lms-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Reservation Date</th>
                                <th>Status</th>
                                <th>Book Availability</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int reservationCounter = 1;
                            }

                            @foreach (var item in recentReservations)
                            {
                                <tr>
                                    <td>@reservationCounter</td>

                                    <td>
                                        <strong>@(item.Book?.Title ?? "Unknown Book")</strong>
                                        <div class="text-muted small">@(item.Book?.Author ?? "Unknown Author")</div>
                                    </td>

                                    <td>
                                        <strong>@(item.ApplicationUser?.FullName ?? "Unknown Member")</strong>
                                        <div class="text-muted small">@(item.ApplicationUser?.Email ?? "")</div>
                                    </td>

                                    <td>@item.ReservationDate.ToString("dd MMM yyyy")</td>

                                    <td>
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="status-badge badge-available">Approved</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="status-badge badge-unavailable">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-pending">Pending</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Book?.IsAvailable == true)
                                        {
                                            <span class="status-badge badge-available">Available</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-unavailable">Unavailable</span>
                                        }
                                    </td>
                                </tr>

                                reservationCounter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bookmark-x text-muted" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No Recent Reservations</h4>
                    <p class="text-muted mb-0">Reservation records will appear here.</p>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .report-kpi-card {
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .report-kpi-card h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
            color: #1f2d2a;
        }

        .report-kpi-card p {
            margin: 0;
            color: #6c7a74;
            font-weight: 600;
        }

    .stat-icon-box {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        flex-shrink: 0;
    }

    .bg-success-soft {
        background: #eaf5ef;
        color: #2e7d5e;
    }

    .bg-primary-soft {
        background: #eef4ff;
        color: #1d4ed8;
    }

    .bg-danger-soft {
        background: #fdecec;
        color: #c0392b;
    }

    .bg-warning-soft {
        background: #fff7e6;
        color: #b7791f;
    }
</style>